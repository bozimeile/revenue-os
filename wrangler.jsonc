{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "revenue-os",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "triggers": {
    "crons": ["0 1 * * 1-5"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revenue-os",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
